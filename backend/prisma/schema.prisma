generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER

  @@map("roles")
}

enum Locale {
  FR
  AR
}

enum AuthProvider {
  GOOGLE
}

enum ShopStatus {
  ACTIVE
  HIDDEN
  MERGED
}

enum ShopPlatform {
  INSTAGRAM
  FACEBOOK
  WEBSITE
}

enum ContentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum ReportReason {
  SPAM
  ABUSE
  MISLEADING
  WRONG_SHOP
  DUPLICATE_SHOP
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationTarget {
  SHOP
  REVIEW
  COMMENT
  USER
  REPORT
}

enum ModerationActionType {
  HIDE
  RESTORE
  MERGE
  CORRECT
  SUSPEND
  REACTIVATE
  RESOLVE_REPORT
  DISMISS_REPORT
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  passwordHash        String?              @map("password_hash")
  fullName            String               @map("full_name")
  role                Role                 @default(USER)
  isActive            Boolean              @default(true) @map("is_active")
  avatarUrl           String?              @map("avatar_url")
  locale              Locale               @default(FR)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  identities          AuthIdentity[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  shops               Shop[]
  reviews             Review[]
  uploads             MediaAsset[]
  likes               ReviewLike[]
  comments            ReviewComment[]
  reports             Report[]             @relation("Reporter")
  resolvedReports     Report[]             @relation("Resolver")
  moderationActions   ModerationAction[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacementId    String?   @unique @map("replacement_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacement      Session?  @relation("Rotation", fields: [replacementId], references: [id], onDelete: SetNull)
  predecessor      Session?  @relation("Rotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  labelFr   String   @map("label_fr")
  labelAr   String   @map("label_ar")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  shops     Shop[]

  @@map("categories")
}

model Shop {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(150)
  slug         String      @unique
  description  String?
  categoryId   String?     @map("category_id") @db.Uuid
  governorate  String?
  logoAssetId  String?     @map("logo_asset_id") @db.Uuid
  createdById  String      @map("created_by_id") @db.Uuid
  status       ShopStatus  @default(ACTIVE)
  mergedIntoId String?     @map("merged_into_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator      User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  logo         MediaAsset? @relation(fields: [logoAssetId], references: [id], onDelete: Restrict)
  mergedInto   Shop?       @relation("ShopMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedShops  Shop[]      @relation("ShopMerge")
  links        ShopLink[]
  reviews      Review[]
  reports      Report[]

  @@index([status, name])
  @@index([categoryId])
  @@index([createdById])
  @@index([mergedIntoId])
  @@map("shops")
}

model ShopLink {
  id            String       @id @default(uuid()) @db.Uuid
  shopId        String       @map("shop_id") @db.Uuid
  platform      ShopPlatform
  originalUrl   String       @map("original_url")
  normalizedUrl String       @map("normalized_url")
  identityKey   String       @unique @map("identity_key")
  handle        String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId])
  @@map("shop_links")
}

model Review {
  id              String              @id @default(uuid()) @db.Uuid
  authorId        String              @map("author_id") @db.Uuid
  shopId          String              @map("shop_id") @db.Uuid
  submissionId    String              @map("submission_id") @db.Uuid
  submissionHash  String              @map("submission_hash")
  rating          Int                 @db.SmallInt
  text            String
  productName     String?             @map("product_name") @db.VarChar(150)
  purchaseDate    DateTime?           @map("purchase_date") @db.Date
  status          ContentStatus       @default(PUBLISHED)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  author          User                @relation(fields: [authorId], references: [id], onDelete: Restrict)
  shop            Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  images          ReviewImage[]
  likes           ReviewLike[]
  comments        ReviewComment[]
  reports         Report[]
  snapshotEntries FeedSnapshotEntry[]

  @@unique([authorId, submissionId])
  @@index([status, createdAt, id])
  @@index([shopId, status, createdAt, id])
  @@index([authorId])
  @@map("reviews")
}

model MediaAsset {
  id           String       @id @default(uuid()) @db.Uuid
  uploaderId   String       @map("uploader_id") @db.Uuid
  storageKey   String       @unique @map("storage_key")
  thumbnailKey String?      @map("thumbnail_key")
  mimeType     String?      @map("mime_type")
  byteSize     BigInt?      @map("byte_size")
  width        Int?
  height       Int?
  status       MediaStatus  @default(PENDING)
  expiresAt    DateTime?    @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  uploader     User         @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  reviewImage  ReviewImage?
  logos        Shop[]

  @@index([uploaderId, status])
  @@index([status, expiresAt])
  @@map("media_assets")
}

model ReviewImage {
  id           String     @id @default(uuid()) @db.Uuid
  reviewId     String     @map("review_id") @db.Uuid
  mediaAssetId String     @unique @map("media_asset_id") @db.Uuid
  position     Int        @db.SmallInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  review       Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([reviewId, position])
  @@map("review_images")
}

model ReviewLike {
  userId    String   @map("user_id") @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId, createdAt, userId])
  @@map("review_likes")
}

model ReviewComment {
  id        String        @id @default(uuid()) @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  reviewId  String        @map("review_id") @db.Uuid
  text      String
  status    ContentStatus @default(PUBLISHED)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  review    Review        @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  reports   Report[]

  @@index([reviewId, status, createdAt, id])
  @@index([authorId])
  @@map("review_comments")
}

model Report {
  id               String         @id @default(uuid()) @db.Uuid
  reporterId       String         @map("reporter_id") @db.Uuid
  shopId           String?        @map("shop_id") @db.Uuid
  reviewId         String?        @map("review_id") @db.Uuid
  commentId        String?        @map("comment_id") @db.Uuid
  reason           ReportReason
  details          String?
  status           ReportStatus   @default(OPEN)
  resolvedById     String?        @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?      @map("resolved_at") @db.Timestamptz(3)
  resolutionReason String?        @map("resolution_reason")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  reporter         User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolver         User?          @relation("Resolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  shop             Shop?          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  review           Review?        @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  comment          ReviewComment? @relation(fields: [commentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt, id])
  @@index([reporterId])
  @@index([shopId])
  @@index([reviewId])
  @@index([commentId])
  @@map("reports")
}

model ModerationAction {
  id            String               @id @default(uuid()) @db.Uuid
  adminId       String               @map("admin_id") @db.Uuid
  targetType    ModerationTarget     @map("target_type")
  targetId      String               @map("target_id") @db.Uuid
  action        ModerationActionType
  reason        String
  previousState Json?                @map("previous_state")
  newState      Json?                @map("new_state")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  admin         User                 @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([adminId])
  @@map("moderation_actions")
}

model FeedSnapshot {
  id               String              @id @default(uuid()) @db.Uuid
  algorithmVersion String              @map("algorithm_version")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime            @map("expires_at") @db.Timestamptz(3)
  entries          FeedSnapshotEntry[]

  @@index([expiresAt])
  @@map("feed_snapshots")
}

model FeedSnapshotEntry {
  snapshotId String       @map("snapshot_id") @db.Uuid
  reviewId   String       @map("review_id") @db.Uuid
  rank       Int
  score      Float
  snapshot   FeedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  review     Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([snapshotId, rank])
  @@unique([snapshotId, reviewId])
  @@index([reviewId])
  @@map("feed_snapshot_entries")
}

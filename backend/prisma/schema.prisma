generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DEVOPS
  VIEWER

  @@map("roles")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  ON_HOLD

  @@map("project_status")
}

enum ProjectMemberRole {
  OWNER
  MEMBER

  @@map("project_member_role")
}

enum EnvironmentType {
  DEV
  STAGING
  PROD

  @@map("environment_type")
}

enum ServerProvider {
  AWS
  AZURE
  GCP
  DIGITALOCEAN
  ON_PREMISES

  @@map("server_provider")
}

enum ServerStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR

  @@map("server_status")
}

enum ApplicationStatus {
  RUNNING
  STOPPED
  DEPLOYING
  FAILED

  @@map("application_status")
}

enum MetricType {
  CPU
  RAM
  DISK

  @@map("metric_type")
}

enum AlertOperator {
  GT
  GTE
  LT
  LTE

  @@map("alert_operator")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("alert_severity")
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("alert_status")
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique
  passwordHash       String          @map("password_hash")
  fullName           String          @map("full_name")
  role               Role            @default(VIEWER)
  isActive           Boolean         @default(true) @map("is_active")
  avatarUrl          String?         @map("avatar_url")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  createdProjects    Project[]       @relation("ProjectCreator")
  projectMemberships ProjectMember[]
  acknowledgedAlerts Alert[]         @relation("AlertAcknowledgedBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Project {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  slug         String          @unique
  description  String?
  status       ProjectStatus   @default(ACTIVE)
  createdById  String?         @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  createdBy    User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  environments Environment[]
  servers      Server[]
  applications Application[]

  @@index([status])
  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Environment {
  id           String          @id @default(uuid()) @db.Uuid
  projectId    String          @map("project_id") @db.Uuid
  type         EnvironmentType
  name         String
  url          String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  servers      Server[]
  applications Application[]

  @@unique([projectId, type])
  @@index([projectId])
  @@map("environments")
}

model Server {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  ipAddress     String         @unique @map("ip_address")
  provider      ServerProvider
  region        String
  cpuCores      Int            @map("cpu_cores")
  ramGb         Int            @map("ram_gb")
  storageGb     Int            @map("storage_gb")
  status        ServerStatus   @default(ONLINE)
  projectId     String?        @map("project_id") @db.Uuid
  environmentId String?        @map("environment_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  environment   Environment?   @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  applications  Application[]
  metrics       Metric[]
  alertRules    AlertRule[]
  alerts        Alert[]

  @@index([projectId])
  @@index([environmentId])
  @@index([provider])
  @@index([region])
  @@index([status])
  @@map("servers")
}

model Application {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  repoUrl       String?           @map("repo_url")
  status        ApplicationStatus @default(STOPPED)
  serverId      String            @map("server_id") @db.Uuid
  projectId     String?           @map("project_id") @db.Uuid
  environmentId String?           @map("environment_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  server        Server            @relation(fields: [serverId], references: [id], onDelete: Restrict)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  environment   Environment?      @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@unique([serverId, name])
  @@index([serverId])
  @@index([projectId])
  @@index([environmentId])
  @@index([status])
  @@map("applications")
}

model Metric {
  id         BigInt   @id @default(autoincrement())
  serverId   String   @map("server_id") @db.Uuid
  cpuUsage   Float    @map("cpu_usage")
  ramUsage   Float    @map("ram_usage")
  diskUsage  Float    @map("disk_usage")
  isUp       Boolean  @default(true) @map("is_up")
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, recordedAt])
  @@index([serverId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@map("metrics")
}

model AlertRule {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String
  metricType          MetricType    @map("metric_type")
  operator            AlertOperator
  threshold           Float
  severity            AlertSeverity
  consecutiveBreaches Int           @default(1) @map("consecutive_breaches")
  enabled             Boolean       @default(true)
  serverId            String?       @map("server_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  server              Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  alerts              Alert[]

  @@index([metricType])
  @@index([severity])
  @@index([enabled])
  @@index([serverId])
  @@map("alert_rules")
}

model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  ruleId           String?       @map("rule_id") @db.Uuid
  serverId         String?       @map("server_id") @db.Uuid
  message          String
  metricValue      Float?        @map("metric_value")
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  triggeredAt      DateTime      @default(now()) @map("triggered_at")
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  acknowledgedById String?       @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  rule             AlertRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  server           Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  acknowledgedBy   User?         @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
  @@index([serverId])
  @@index([ruleId])
  @@index([triggeredAt(sort: Desc)])
  @@map("alerts")
}

DATABASE_URL="postgresql://vero:vero@127.0.0.1:5433/vero?schema=public"

# Docker Compose local database defaults (development only).
POSTGRES_USER=vero
POSTGRES_PASSWORD=vero
POSTGRES_DB=vero
POSTGRES_PORT=5433

JWT_SECRET="replace_with_a_random_secret_at_least_32_characters"
JWT_EXPIRES_IN="1h"

PORT=3000
CORS_ORIGIN="http://localhost:8081,http://127.0.0.1:8081"
NODE_ENV="development"

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_DEMO_DATA=false

# Sessions and Google. Empty client IDs disable Google sign-in.
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ALLOWED_AUDIENCES=""

# Planned media and recovery integrations. Keep credentials server-side.
MEDIA_DRIVER=s3
MEDIA_ENDPOINT="http://127.0.0.1:9090"
MEDIA_BUCKET="vero-reviews"
MEDIA_ACCESS_KEY_ID="local"
MEDIA_SECRET_ACCESS_KEY="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
MEDIA_SIGNED_URL_TTL_SECONDS=300
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Vero <no-reply@vero.invalid>"
PASSWORD_RESET_URL="http://localhost:8081/reset-password"

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
